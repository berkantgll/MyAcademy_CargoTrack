@model CargoTrack.DTO.CargoDtos.CargoTrackingDto
@using CargoTrack.Entity.Enums
@{
    Layout = null;
    var culture = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var movements = Model.CargoMovements.OrderByDescending(x => x.MovementDate).ToList();
    var statusLabels = new Dictionary<CargoStatus, string>
    {
        [CargoStatus.Created] = "Gönderi Oluşturuldu",
        [CargoStatus.AtOriginBranch] = "Çıkış Şubesinde",
        [CargoStatus.AtTransferCenter] = "Transfer Merkezinde",
        [CargoStatus.AtDestinationBranch] = "Varış Şubesinde",
        [CargoStatus.OutForDelivery] = "Dağıtıma Çıktı",
        [CargoStatus.Delivered] = "Teslim Edildi",
        [CargoStatus.DeliveryFailed] = "Teslim Edilemedi",
        [CargoStatus.ReturnInProgress] = "İade Sürecinde",
        [CargoStatus.ReturnedToSender] = "Göndericiye İade Edildi"
    };
}
<!DOCTYPE html>

<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Kargo Takip - Gönderi Detayları</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@@400;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        "colors": {
                            "surface-container-high": "#dce9ff",
                            "tertiary-container": "#171e24",
                            "tertiary-fixed": "#dce3eb",
                            "on-surface-variant": "#43474e",
                            "on-secondary-container": "#603100",
                            "outline": "#74777e",
                            "secondary-fixed": "#ffdcc3",
                            "secondary": "#904d00",
                            "background": "#f8f9ff",
                            "inverse-on-surface": "#eaf1ff",
                            "error": "#ba1a1a",
                            "on-background": "#0b1c30",
                            "on-tertiary-fixed-variant": "#40484e",
                            "on-primary-fixed-variant": "#2f4868",
                            "surface-bright": "#f8f9ff",
                            "primary-fixed-dim": "#afc8ee",
                            "primary-fixed": "#d3e3ff",
                            "on-secondary-fixed": "#2f1500",
                            "primary-container": "#001e3c",
                            "surface-container-highest": "#d3e4fe",
                            "on-primary-fixed": "#001c39",
                            "primary": "#00040c",
                            "on-primary": "#ffffff",
                            "secondary-fixed-dim": "#ffb77d",
                            "surface-variant": "#d3e4fe",
                            "surface-dim": "#cbdbf5",
                            "error-container": "#ffdad6",
                            "on-tertiary-container": "#7f868d",
                            "on-secondary-fixed-variant": "#6e3900",
                            "outline-variant": "#c4c6ce",
                            "surface-container": "#e5eeff",
                            "inverse-surface": "#213145",
                            "on-primary-container": "#6f87aa",
                            "tertiary-fixed-dim": "#c0c7cf",
                            "on-tertiary-fixed": "#151c22",
                            "on-surface": "#0b1c30",
                            "on-tertiary": "#ffffff",
                            "surface-container-low": "#eff4ff",
                            "inverse-primary": "#afc8ee",
                            "on-error-container": "#93000a",
                            "surface-tint": "#486081",
                            "surface-container-lowest": "#ffffff",
                            "on-error": "#ffffff",
                            "surface": "#f8f9ff",
                            "tertiary": "#000307",
                            "secondary-container": "#fd8b00",
                            "on-secondary": "#ffffff"
                        },
                        "borderRadius": {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                        },
                        "spacing": {
                            "section-padding": "4rem",
                            "container-max-width": "1200px",
                            "stack-sm": "0.5rem",
                            "stack-md": "1rem",
                            "stack-lg": "2rem",
                            "gutter": "1.5rem",
                            "margin-mobile": "1rem"
                        },
                        "fontFamily": {
                            "status-label": ["Hanken Grotesk"],
                            "body-lg": ["Hanken Grotesk"],
                            "headline-lg-mobile": ["Hanken Grotesk"],
                            "headline-md": ["Hanken Grotesk"],
                            "headline-lg": ["Hanken Grotesk"],
                            "body-md": ["Hanken Grotesk"],
                            "headline-xl": ["Hanken Grotesk"],
                            "label-caps": ["Hanken Grotesk"]
                        },
                        "fontSize": {
                            "status-label": ["13px", { "lineHeight": "18px", "fontWeight": "600" }],
                            "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                            "headline-lg-mobile": ["28px", { "lineHeight": "36px", "fontWeight": "600" }],
                            "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                            "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                            "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                            "headline-xl": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                            "label-caps": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700" }]
                        }
                    }
                }
            }
    </script>
    <style>
            body {
                font-family: 'Hanken Grotesk', sans-serif;
                background-color: #F8FAFC;
            }

            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            }

            .timeline-line::before {
                content: '';
                position: absolute;
                left: 11px;
                top: 24px;
                bottom: -24px;
                width: 2px;
                background-color: #E2E8F0;
                z-index: 0;
            }

            .timeline-item:last-child .timeline-line::before {
                display: none;
            }

            .progress-bar-bg {
                background-color: #334155;
            }

            .progress-bar-fill {
                background-color: #fd8b00;
            }
    </style>
</head>
<body class="text-on-background font-body-md min-h-screen flex flex-col">
 
    <header class="bg-surface docked full-width top-0 border-b border-outline-variant shadow-sm z-50">
        <div class="flex justify-between items-center px-gutter py-4 max-w-container-max-width mx-auto w-full">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-3xl" style="font-variation-settings: 'FILL' 1;">local_shipping</span>
                <span class="font-headline-md text-headline-md font-bold text-on-background">CargoTrack</span>
            </div>
            <nav class="hidden md:flex gap-6 items-center">
                <a class="text-on-surface-variant hover:text-primary transition-colors py-2" href="#">Ana Sayfa</a>
                <a class="text-secondary font-bold border-b-2 border-secondary pb-1 py-2" href="#">Kargo Takip</a>
                <a class="text-on-surface-variant hover:text-primary transition-colors py-2" href="#">Şubelerimiz</a>
                <a class="text-on-surface-variant hover:text-primary transition-colors py-2" href="#">Hizmetlerimiz</a>
                <a class="text-on-surface-variant hover:text-primary transition-colors py-2" href="#">Hakkımızda</a>
                <a class="text-on-surface-variant hover:text-primary transition-colors py-2" href="#">İletişim</a>
            </nav>
            <button class="bg-primary-container text-on-primary px-6 py-2 rounded-lg font-body-md font-semibold hover:bg-opacity-90 transition-colors hidden md:block">
                Kargo Gönder
            </button>
            <button class="md:hidden text-on-background">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>
    </header>
    <!-- Main Content -->
    <main class="flex-grow w-full max-w-container-max-width mx-auto px-gutter py-8 md:py-12">
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
            <div>
                <h1 class="font-headline-lg text-headline-lg text-primary-container mb-2">Gönderi Detayları</h1>
                <p class="text-on-surface-variant font-body-md">Gönderinizin güncel durumunu ve hareket geçmişini inceleyin.</p>
            </div>
            <div class="flex gap-3 w-full md:w-auto">
                <button type="button" onclick="window.print()" class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-surface-container-high text-primary-container border border-primary-container/20 px-4 py-2.5 rounded-lg font-semibold hover:bg-surface-container-highest transition-colors">
                    <span class="material-symbols-outlined">print</span>
                    Kargo Detayını Yazdır
                </button>
                <a asp-controller="Tracking" asp-action="Index" class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-secondary-container text-on-secondary px-6 py-2.5 rounded-lg font-semibold hover:bg-opacity-90 transition-colors shadow-sm">
                    <span class="material-symbols-outlined">search</span>
                    Yeni Kargo Sorgula
                </a>
            </div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
           
            <div class="lg:col-span-8 flex flex-col gap-6">
           
                <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6 flex flex-col md:flex-row gap-8">
                   
                    <div class="flex-1 border-r-0 md:border-r border-outline-variant/30 pr-0 md:pr-6">
                        <div class="mb-6">
                            <p class="font-label-caps text-label-caps text-outline mb-1 uppercase">Takip Numarası</p>
                            <h2 class="font-headline-md text-headline-md text-primary-container">@Model.TrackingNumber</h2>
                        </div>
                        <div class="inline-flex items-center gap-1.5 bg-surface-container-high text-primary-container px-3 py-1 rounded-full font-status-label text-status-label mb-6">
                            <span class="material-symbols-outlined text-[16px]">local_shipping</span>
                            @statusLabels[Model.Status]
                        </div>
                        <div class="flex gap-8">
                            <div>
                                <p class="text-sm text-outline mb-1">Gönderim Tarihi</p>
                                <p class="font-semibold text-on-background">@Model.CreatedDate.ToString("dd MMMM yyyy", culture)</p>
                            </div>
                            <div>
                                <p class="text-sm text-outline mb-1">Tahmini Varış</p>
                                <p class="font-semibold text-on-background">@Model.EstimatedDeliveryDate.ToString("dd MMMM yyyy", culture)</p>
                            </div>
                        </div>
                    </div>
                   
                    <div class="flex-1 flex flex-col justify-center">
                        <div class="flex justify-between items-center mb-2">
                            <div class="flex flex-col items-center">
                                <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center mb-2 text-primary-container">
                                    <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">location_on</span>
                                </div>
                                <span class="font-semibold text-on-background">@Model.OriginBranchCity</span>
                                <span class="text-xs text-outline">@Model.OriginBranchName</span>
                            </div>
                            <div class="flex-grow flex items-center px-2">
                                <div class="w-2 h-2 rounded-full bg-outline-variant"></div>
                                <div class="flex-grow h-px bg-outline-variant relative">
                                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-surface-container-lowest px-2">
                                        <span class="material-symbols-outlined text-secondary-container" style="font-variation-settings: 'FILL' 1;">local_shipping</span>
                                    </div>
                                </div>
                                <div class="w-2 h-2 rounded-full bg-outline-variant"></div>
                            </div>
                            <div class="flex flex-col items-center">
                                <div class="w-8 h-8 rounded-full bg-surface-container text-outline flex items-center justify-center mb-2">
                                    <span class="material-symbols-outlined text-[18px]">flag</span>
                                </div>
                                <span class="font-semibold text-on-background">@Model.DestinationBranchCity</span>
                                <span class="text-xs text-outline">@Model.DestinationBranchName</span>
                            </div>
                        </div>
                    </div>
                </div>
               
                <section class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6">
                    <h3 class="font-headline-md text-xl text-primary-container mb-4">Gönderi Rotası</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-surface rounded-lg p-4"><p class="text-sm text-outline mb-1">Çıkış Şubesi</p><p class="font-semibold text-on-background">@Model.OriginBranchName (@Model.OriginBranchCity)</p></div>
                        <div class="bg-surface rounded-lg p-4"><p class="text-sm text-outline mb-1">Varış Şubesi</p><p class="font-semibold text-on-background">@Model.DestinationBranchName (@Model.DestinationBranchCity)</p></div>
                    </div>
                </section>
             
                <div class="bg-primary-container rounded-xl shadow-sm p-6 text-on-primary">
                    <div class="flex items-center gap-3 mb-2">
                        <span class="material-symbols-outlined text-[28px]">schedule</span>
                        <h3 class="font-headline-md text-2xl font-bold">@(Model.DeliveredAt.HasValue ? "Teslim Tarihi" : "Tahmini Teslimat")</h3>
                    </div>
                    <p class="text-primary-fixed-dim ml-10 text-xl">@(Model.DeliveredAt.HasValue ? Model.DeliveredAt.Value.ToString("dd MMMM yyyy", culture) : Model.EstimatedDeliveryDate.ToString("dd MMMM yyyy", culture))</p>
                </div>
            </div>
         
            <div class="lg:col-span-4">
                <section class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6 h-full">
                    <div class="flex items-center gap-2 mb-6 pb-4 border-b border-outline-variant/30">
                        <span class="material-symbols-outlined text-primary-container">history</span>
                        <h3 class="font-headline-md text-xl text-primary-container">Kargo Hareketleri</h3>
                    </div>
                    @if (movements.Count == 0)
                    {
                        <p class="text-on-surface-variant">Bu gönderi için henüz hareket kaydı bulunmuyor.</p>
                    }
                    else
                    {
                        <ol class="relative border-s-2 border-outline-variant ms-3">
                            @foreach (var movement in movements)
                            {
                                <li class="mb-8 ms-6">
                                    <span class="absolute flex items-center justify-center w-6 h-6 bg-secondary-container text-white rounded-full -start-3 ring-4 ring-white">
                                        <span class="material-symbols-outlined text-[14px]">check</span>
                                    </span>
                                    <h4 class="font-semibold text-on-background">@statusLabels[movement.Status]</h4>
                                    <time class="text-sm text-outline">@movement.MovementDate.ToString("dd MMM yyyy HH:mm", culture)</time>
                                </li>
                            }
                        </ol>
                    }
                </section>
            </div>
        </div>
    </main>
    <!-- Footer -->
    <footer class="bg-primary-container text-on-primary-container py-section-padding px-gutter w-full mt-auto">
        <div class="max-w-container-max-width mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="font-headline-md text-headline-md font-bold text-surface-bright">
                CargoTrack
            </div>
            <div class="flex flex-wrap justify-center gap-4 md:gap-8 text-sm">
                <a class="opacity-80 hover:opacity-100 hover:text-secondary-fixed transition-colors" href="#">Gizlilik Politikası</a>
                <a class="opacity-80 hover:opacity-100 hover:text-secondary-fixed transition-colors" href="#">Kullanım Şartları</a>
                <a class="opacity-80 hover:opacity-100 hover:text-secondary-fixed transition-colors" href="#">KVKK Aydınlatma Metni</a>
                <a class="opacity-80 hover:opacity-100 hover:text-secondary-fixed transition-colors" href="#">Sıkça Sorulan Sorular</a>
            </div>
            <div class="text-sm opacity-80">
                © @DateTime.Now.Year CargoTrack Lojistik A.Ş. Tüm hakları saklıdır.
            </div>
        </div>
    </footer>
</body>
</html>
