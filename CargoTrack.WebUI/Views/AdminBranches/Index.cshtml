@model List<CargoTrack.DTO.BranchDtos.BranchDto>
@{
    Layout = "_PanelLayout";
    ViewData["Title"] = "Şube Yönetimi";
    var branches = Model ?? new List<CargoTrack.DTO.BranchDtos.BranchDto>();
    var activeCount = branches.Count(x => x.IsActive);
    var inactiveCount = branches.Count - activeCount;
    var cityCount = branches.Select(x => x.BranchCity?.Trim()).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
}
<style>
    .br-page {
        color: #0b1c30;
    }

    .br-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        flex-wrap: wrap;
        margin-bottom: 23px;
    }

    .br-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: #f18a07;
        font-size: 11px;
        letter-spacing: 1.5px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .br-title {
        margin: 0;
        color: #10243d;
        font-size: clamp(25px, 2.6vw, 33px);
        font-weight: 800;
        letter-spacing: -.85px;
    }

    .br-subtitle {
        margin: 8px 0 0;
        color: #8291a3;
        font-size: 13px;
        line-height: 1.6;
    }

    .br-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 11px 17px;
        border: 0;
        border-radius: 11px;
        color: #10243d;
        background: #fd8b00;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 7px 18px rgba(253,139,0,.13);
    }

        .br-primary:hover {
            background: #efa000;
            color: #10243d;
        }

    .br-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 41px;
        padding: 9px 13px;
        border: 1px solid #e1e8f1;
        border-radius: 10px;
        background: #fff;
        color: #344a64;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

        .br-ghost:hover {
            color: #e48200;
            border-color: #ffc77e;
        }

    .br-stats {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 15px;
        margin-bottom: 21px;
    }

    .br-stat {
        padding: 20px;
        background: #fff;
        border: 1px solid #e7ecf3;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(27,49,77,.025);
    }

    .br-stat-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .br-stat-label {
        font-size: 12px;
        font-weight: 700;
        color: #7b8b9e;
    }

    .br-stat-icon {
        width: 35px;
        height: 35px;
        border-radius: 10px;
        background: #edf3fc;
        color: #376392;
        display: grid;
        place-items: center;
    }

        .br-stat-icon.orange {
            background: #fff2e3;
            color: #e58b17;
        }

        .br-stat-icon.green {
            background: #e5f7ed;
            color: #1e8b61;
        }

        .br-stat-icon.red {
            background: #fff0f0;
            color: #cb6262;
        }

    .br-stat-number {
        font-size: 28px;
        font-weight: 800;
        color: #11273f;
        line-height: 1.1;
        margin-top: 15px;
    }

    .br-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(290px, .85fr);
        gap: 19px;
        align-items: start;
    }

    .br-card {
        border: 1px solid #e5ebf2;
        border-radius: 15px;
        background: #fff;
        box-shadow: 0 5px 24px rgba(22,42,66,.025);
        overflow: hidden;
    }

    .br-card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 21px 22px;
        border-bottom: 1px solid #eef1f6;
    }

    .br-card-heading {
        margin: 0;
        font-size: 16px;
        font-weight: 800;
        color: #132a43;
    }

    .br-card-detail {
        font-size: 11px;
        color: #8695a7;
        margin: 6px 0 0;
    }

    .br-card-body {
        padding: 21px 22px 25px;
    }

    .br-search {
        display: flex;
        align-items: center;
        gap: 9px;
        border: 1px solid #e1e8f1;
        border-radius: 9px;
        padding: 0 12px;
        background: #fbfcff;
        min-height: 40px;
    }

        .br-search .material-symbols-outlined {
            color: #98a8ba;
            font-size: 19px;
        }

        .br-search input {
            min-width: 0;
            width: 190px;
            max-width: 100%;
            outline: 0;
            border: 0;
            background: transparent;
            font-size: 12px;
            color: #263c56;
        }

    .br-table-scroll {
        width: 100%;
        overflow-x: auto;
    }

    .br-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 620px;
    }

        .br-table th {
            padding: 15px 19px;
            text-align: left;
            white-space: nowrap;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .8px;
            background: #f8faff;
            color: #8b9bb0;
            font-weight: 800;
        }

        .br-table td {
            padding: 17px 19px;
            border-top: 1px solid #f0f3f7;
            vertical-align: middle;
            font-size: 12px;
            color: #3c536d;
        }

        .br-table tbody tr:hover {
            background: #fbfcff;
        }

    .br-name {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .br-bubble {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border: 1px solid #dbe8f5;
        background: #edf4fc;
        color: #386794;
        border-radius: 9px;
        flex: 0 0 auto;
    }

    .br-name-main {
        font-weight: 800;
        color: #18314d;
        font-size: 12px;
    }

    .br-name-sub {
        font-size: 10px;
        color: #9aaaaf;
        margin-top: 3px;
    }

    .br-code {
        font-size: 11px;
        font-weight: 800;
        color: #5d7290;
        padding: 6px 9px;
        background: #f4f7fb;
        border-radius: 7px;
        display: inline-block;
        white-space: nowrap;
    }

    .br-status {
        font-size: 11px;
        font-weight: 800;
        padding: 7px 11px;
        border-radius: 50px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

        .br-status::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .br-status.active {
            color: #16825b;
            background: #e7f8ef;
        }

        .br-status.inactive {
            color: #9b6471;
            background: #f9edf0;
        }

    .br-empty {
        padding: 45px 20px;
        text-align: center;
        color: #8596a9;
    }

        .br-empty .material-symbols-outlined {
            display: block;
            font-size: 37px;
            color: #9eb3c9;
            margin-bottom: 10px;
        }

    .br-field {
        margin-bottom: 17px;
    }

    .br-label {
        font-size: 11px;
        font-weight: 800;
        color: #3d536b;
        margin: 0 0 8px;
        display: block;
    }

        .br-label b {
            color: #e79017;
        }

    .br-input {
        outline: 0;
        display: block;
        width: 100%;
        height: 43px;
        border: 1px solid #e0e7f0;
        background: #fbfcff;
        color: #213a56;
        border-radius: 9px;
        padding: 10px 12px;
        font-size: 12px;
    }

        .br-input:focus {
            background: #fff;
            border-color: #ed9c37;
            box-shadow: 0 0 0 3px rgba(253,139,0,.12);
        }

    .br-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 13px;
    }

    .br-tip {
        border-radius: 10px;
        background: #f3f7ff;
        padding: 13px;
        display: flex;
        gap: 10px;
        align-items: flex-start;
        color: #647f9e;
        font-size: 11px;
        line-height: 1.6;
        margin: 6px 0 21px;
    }

        .br-tip .material-symbols-outlined {
            color: #6392c2;
        }

    .br-submit {
        width: 100%;
    }

    .br-notice {
        display: flex;
        align-items: start;
        gap: 10px;
        padding: 14px 16px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 18px;
    }

        .br-notice.success {
            background: #e8f7ee;
            color: #1e7855;
            border: 1px solid #c5ecd6;
        }

        .br-notice.error {
            background: #fff1f0;
            color: #ba4b48;
            border: 1px solid #f5d3d1;
        }

    .br-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        flex-wrap: wrap;
        padding: 15px 21px;
        background: #fbfcfe;
        border-top: 1px solid #edf1f6;
        color: #91a1b4;
        font-size: 11px;
    }

    .br-quick {
        border: 1px solid #e9eef6;
        border-radius: 13px;
        margin-top: 17px;
        background: #fff;
        padding: 19px;
    }

    .br-quick-title {
        display: flex;
        gap: 9px;
        align-items: center;
        color: #163452;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .br-quick p {
        color: #8295a9;
        font-size: 11px;
        line-height: 1.6;
        margin-bottom: 14px;
    }

    @@media (max-width: 1220px) {
        .br-stats {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }

        .br-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575px) {
        .br-stats {
            grid-template-columns: 1fr 1fr;
            gap: 9px;
        }

        .br-stat {
            padding: 14px;
        }

        .br-stat-number {
            font-size: 23px;
        }

        .br-stat-icon {
            width: 30px;
            height: 30px;
        }

        .br-grid {
            gap: 14px;
        }

        .br-card-head, .br-card-body {
            padding: 16px;
        }

        .br-form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .br-search input {
            width: 145px;
        }
    }

    .br-table {
        min-width: 850px;
    }

    .br-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
    }

        .br-actions form {
            margin: 0;
        }

    .br-delete {
        color: #bf4545;
        border-color: #f0d4d4;
        cursor: pointer;
    }

        .br-delete:hover {
            background: #fff0f0;
            color: #bf4545;
        }

</style>

<div class="br-page">
    <div class="br-top">
        <div>
            <div class="br-eyebrow"><span class="material-symbols-outlined" style="font-size:18px">corporate_fare</span> OPERASYON AĞI</div>
            <h1 class="br-title">Şube Yönetimi</h1>
            <p class="br-subtitle">Şube ağınızı yönetin, yeni lokasyonlar ekleyin ve yöneticileri şubelere atayın.</p>
        </div>
        <a class="br-primary" href="#branch-create"><span class="material-symbols-outlined" style="font-size:18px">add</span> Yeni Şube Ekle</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="br-notice success" role="status"><span class="material-symbols-outlined">check_circle</span><span>@TempData["Success"]</span></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="br-notice error" role="alert"><span class="material-symbols-outlined">error</span><span>@TempData["Error"]</span></div>
    }

    <section class="br-stats" aria-label="Şube istatistikleri">
        <div class="br-stat"><div class="br-stat-head"><span class="br-stat-label">Toplam Şube</span><span class="br-stat-icon"><span class="material-symbols-outlined">apartment</span></span></div><div class="br-stat-number">@branches.Count</div></div>
        <div class="br-stat"><div class="br-stat-head"><span class="br-stat-label">Aktif Şube</span><span class="br-stat-icon green"><span class="material-symbols-outlined">check_circle</span></span></div><div class="br-stat-number">@activeCount</div></div>
        <div class="br-stat"><div class="br-stat-head"><span class="br-stat-label">Pasif Şube</span><span class="br-stat-icon red"><span class="material-symbols-outlined">do_not_disturb_on</span></span></div><div class="br-stat-number">@inactiveCount</div></div>
        <div class="br-stat"><div class="br-stat-head"><span class="br-stat-label">Hizmet Verilen Şehir</span><span class="br-stat-icon orange"><span class="material-symbols-outlined">map</span></span></div><div class="br-stat-number">@cityCount</div></div>
    </section>

    <div class="br-grid">
        <section class="br-card">
            <div class="br-card-head">
                <div><h2 class="br-card-heading">Kayıtlı Şubeler</h2><p class="br-card-detail">Sistemdeki şubeler ve güncel durumları</p></div>
                <label class="br-search"><span class="material-symbols-outlined">search</span><input id="brSearch" type="search" placeholder="Şube veya şehir ara..." aria-label="Şube ara" /></label>
            </div>
            <div class="br-table-scroll">
                <table class="br-table" id="brTable">
                    <thead>
                        <tr>
                            <th>Şube</th>
                            <th>Şube Kodu</th>
                            <th>Şehir</th>
                            <th>Telefon</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var branch in branches.OrderByDescending(x => x.IsActive).ThenBy(x => x.BranchName))
                        {
                            <tr class="br-data-row">
                                <td><div class="br-name"><span class="br-bubble"><span class="material-symbols-outlined" style="font-size:19px">storefront</span></span><div><div class="br-name-main">@branch.BranchName</div><div class="br-name-sub">Şube kaydı</div></div></div></td>
                                <td><span class="br-code">@branch.BranchCode</span></td>
                                <td>@branch.BranchCity</td>
                                <td>@(string.IsNullOrWhiteSpace(branch.PhoneNumber) ? "—" : branch.PhoneNumber)</td>
                                <td><span class="br-status @(branch.IsActive ? "active" : "inactive")">@(branch.IsActive ? "Aktif" : "Pasif")</span></td>

                                <td>
                                    <div class="br-actions">

                                        <a asp-controller="AdminBranches"
                                           asp-action="Edit"
                                           asp-route-id="@branch.Id"
                                           class="br-ghost">
                                            Düzenle
                                        </a>

                                        @if (!branch.IsActive)
                                        {
                                            <form asp-controller="AdminBranches"
                                                  asp-action="Delete"
                                                  method="post"
                                                  onsubmit="return confirm('Bu şube silinsin mi?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@branch.Id" />

                                                <button type="submit"
                                                        class="br-ghost br-delete">
                                                    Sil
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="brSearchEmpty" class="br-empty" style="display:none"><span class="material-symbols-outlined">search_off</span>Aramanıza uygun şube bulunamadı.</div>
            @if (!branches.Any())
            {
                <div class="br-empty"><span class="material-symbols-outlined">domain_add</span>Henüz şube eklenmemiş. Sağdaki formdan ilk şubenizi oluşturabilirsiniz.</div>
            }
            <div class="br-footer"><span><span id="brVisibleCount">@branches.Count</span> şube görüntüleniyor</span><span>Şubeler veritabanından listelenir</span></div>
        </section>

        <div>
            <section class="br-card" id="branch-create">
                <div class="br-card-head"><div><h2 class="br-card-heading">Yeni Şube Oluştur</h2><p class="br-card-detail">Şube bilgilerini doldurarak kaydı tamamlayın</p></div><span class="br-stat-icon orange"><span class="material-symbols-outlined">add_business</span></span></div>
                <div class="br-card-body">
                    <form asp-controller="AdminBranches" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="br-form-row">
                            <div class="br-field"><label for="BranchCode" class="br-label">Şube Kodu <b>*</b></label><input class="br-input" id="BranchCode" name="BranchCode" maxlength="30" required placeholder="BRN001" autocomplete="off" /></div>
                            <div class="br-field"><label for="BranchCity" class="br-label">Şehir <b>*</b></label><input class="br-input" id="BranchCity" name="BranchCity" maxlength="100" required placeholder="İzmir" /></div>
                        </div>
                        <div class="br-field"><label for="BranchName" class="br-label">Şube Adı <b>*</b></label><input class="br-input" id="BranchName" name="BranchName" maxlength="150" required placeholder="Bornova Şubesi" /></div>
                        <div class="br-field"><label for="PhoneNumber" class="br-label">İletişim Telefonu</label><input class="br-input" id="PhoneNumber" name="PhoneNumber" type="tel" maxlength="40" placeholder="0232 000 00 00" /></div>
                        <div class="br-tip"><span class="material-symbols-outlined">info</span><span>Şube oluşturulduktan sonra kullanıcı yönetiminden bir müdürü bu şubeye atayabilirsiniz. Yeni şubeler otomatik olarak aktif açılır.</span></div>
                        <button type="submit" class="br-primary br-submit"><span class="material-symbols-outlined" style="font-size:18px">check_circle</span> Şubeyi Kaydet</button>
                    </form>
                </div>
            </section>
            <section class="br-quick">
                <div class="br-quick-title"><span class="material-symbols-outlined" style="color:#fd8b00">supervisor_account</span> Şube Müdürü Atama</div>
                <p>Yeni eklenen şubeye mevcut bir kullanıcıyı <strong>Manager</strong> rolüyle atamak için kullanıcı yönetimi ekranını kullanın.</p>
                <a asp-controller="AdminUsers" asp-action="Index" class="br-ghost"><span class="material-symbols-outlined" style="font-size:17px">manage_accounts</span> Müdür Atamalarına Git</a>
            </section>
        </div>
    </div>
</div>

<script>
    (function () {
        const input = document.getElementById('brSearch');
        const rows = Array.from(document.querySelectorAll('#brTable tbody tr.br-data-row'));
        const empty = document.getElementById('brSearchEmpty');
        const count = document.getElementById('brVisibleCount');
        if (!input || !empty || !count) return;
        input.addEventListener('input', function () {
            const q = this.value.trim().toLocaleLowerCase('tr');
            let visible = 0;
            rows.forEach(function (row) {
                const isMatch = row.textContent.toLocaleLowerCase('tr').includes(q);
                row.style.display = isMatch ? '' : 'none';
                if (isMatch) visible++;
            });
            count.textContent = visible;
            empty.style.display = rows.length > 0 && visible === 0 ? 'block' : 'none';
        });
    })();
</script>

