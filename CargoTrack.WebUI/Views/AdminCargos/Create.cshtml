@using CargoTrack.Entity.Enums
@model CargoTrack.WebUI.Models.AdminCargoCreateVm

@{
    ViewData["Title"] = "Yeni Kargo Oluştur";
    bool missingData = Model.Customers.Count < 2
        || Model.Branches.Count < 2
        || Model.Addresses.Count == 0;
}

<div class="container py-4">
    <h2>Yeni Kargo Oluştur</h2>

    <p>Gönderici, alıcı, şube ve kargo bilgilerini seçiniz.</p>

    <div asp-validation-summary="All" class="text-danger"></div>

    @if (missingData)
    {
        <div class="alert alert-warning">
            Kargo oluşturabilmek için en az 2 müşteri,
            2 aktif şube ve 1 teslimat adresi gereklidir.
        </div>
    }

    <form asp-controller="AdminCargos"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Gönderici</label>
                <select asp-for="Cargo.SenderId"
                        asp-items="Model.Customers"
                        class="form-select">
                    <option value="">Gönderici seçiniz</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Alıcı</label>
                <select asp-for="Cargo.ReceiverId"
                        asp-items="Model.Customers"
                        class="form-select">
                    <option value="">Alıcı seçiniz</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Çıkış Şubesi</label>
                <select asp-for="Cargo.OriginBranchId"
                        asp-items="Model.Branches"
                        class="form-select">
                    <option value="">Çıkış şubesi seçiniz</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Varış Şubesi</label>
                <select asp-for="Cargo.DestinationBranchId"
                        asp-items="Model.Branches"
                        class="form-select">
                    <option value="">Varış şubesi seçiniz</option>
                </select>
            </div>

            <div class="col-md-12">
                <label class="form-label">Teslimat Adresi</label>
                <select asp-for="Cargo.DeliveryAddressId"
                        asp-items="Model.Addresses"
                        class="form-select">
                    <option value="">Adres seçiniz</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Gönderi Tipi</label>
                <select asp-for="Cargo.Type"
                        asp-items="Html.GetEnumSelectList<DeliveryType>()"
                        class="form-select">
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Ağırlık (kg)</label>
                <input asp-for="Cargo.WeightKg"
                       type="number" min="0.01" step="0.01"
                       class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label">En (cm)</label>
                <input asp-for="Cargo.WidthCm"
                       type="number" min="0.01" step="0.01"
                       class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Boy (cm)</label>
                <input asp-for="Cargo.LengthCm"
                       type="number" min="0.01" step="0.01"
                       class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Yükseklik (cm)</label>
                <input asp-for="Cargo.HeightCm"
                       type="number" min="0.01" step="0.01"
                       class="form-control" />
            </div>

            <div class="col-md-12">
                <label class="form-label">Ek Hizmetler</label>

                <div>
                    <label>
                        <input type="checkbox"
                               name="SelectedExtraServices"
                               value="1" />
                        Özel Paketleme
                    </label>
                </div>

                <div>
                    <label>
                        <input type="checkbox"
                               name="SelectedExtraServices"
                               value="2" />
                        Hediye Paketi
                    </label>
                </div>

                <div>
                    <label>
                        <input type="checkbox"
                               name="SelectedExtraServices"
                               value="4" />
                        Sigorta
                    </label>
                </div>
            </div>

            <div class="col-md-12">
                <label>
                    <input asp-for="Cargo.IsFragile"
                           type="checkbox" />
                    Kırılabilir Kargo
                </label>
            </div>

            <div class="col-12">
                <button type="submit"
                        class="btn btn-primary"
                        disabled="@missingData">
                    Kargo Oluştur
                </button>

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Vazgeç
                </a>
            </div>

        </div>
    </form>
</div>
