@using CargoTrack.Entity.Enums
@model CargoTrack.WebUI.Models.AdminCargoEditVm

@{
    ViewData["Title"] = "Kargo Güncelle";
}

<div class="container py-4">

    <h2>Kargo Güncelle</h2>

    <form asp-controller="AdminCargos"
          asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Cargo.CargoId" type="hidden" />

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label>Çıkış Şubesi</label>

            <select asp-for="Cargo.OriginBranchId"
                    asp-items="Model.Branches"
                    class="form-select">
            </select>
        </div>

        <div class="mb-3">
            <label>Varış Şubesi</label>

            <select asp-for="Cargo.DestinationBranchId"
                    asp-items="Model.Branches"
                    class="form-select">
            </select>
        </div>

        <div class="mb-3">
            <label>Teslimat Adresi</label>

            <select asp-for="Cargo.DeliveryAddressId"
                    asp-items="Model.Addresses"
                    class="form-select">
            </select>
        </div>

        <div class="mb-3">
            <label>Gönderi Tipi</label>

            <select asp-for="Cargo.Type"
                    asp-items="Html.GetEnumSelectList<DeliveryType>()"
                    class="form-select">
            </select>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label>Ağırlık (kg)</label>

                <input asp-for="Cargo.WeightKg"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control" />
            </div>

            <div class="col-md-3 mb-3">
                <label>En (cm)</label>

                <input asp-for="Cargo.WidthCm"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control" />
            </div>

            <div class="col-md-3 mb-3">
                <label>Boy (cm)</label>

                <input asp-for="Cargo.LengthCm"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control" />
            </div>

            <div class="col-md-3 mb-3">
                <label>Yükseklik (cm)</label>

                <input asp-for="Cargo.HeightCm"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control" />
            </div>
        </div>

        <h4>Ek Hizmetler</h4>

        @foreach (var service in Enum.GetValues<ExtraServiceType>()
            .Where(x => x != ExtraServiceType.None))
        {
            <div class="form-check">
                <input type="checkbox"
                       name="SelectedExtraServices"
                       value="@((int)service)"
                       checked="@(Model.SelectedExtraServices.Contains(service))"
                       class="form-check-input" />

                <label class="form-check-label">
                    @service
                </label>
            </div>
        }

        <div class="form-check my-3">
            <input asp-for="Cargo.IsFragile"
                   class="form-check-input" />

            <label class="form-check-label">
                Kırılabilir Kargo
            </label>
        </div>

        <button type="submit" class="btn btn-primary">
            Değişiklikleri Kaydet
        </button>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-secondary">
            Vazgeç
        </a>

    </form>
</div>
