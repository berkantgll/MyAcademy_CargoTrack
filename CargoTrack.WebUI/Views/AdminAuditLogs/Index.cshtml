@model CargoTrack.DTO.AuditDtos.AuditLogPageDto

@{
    Layout = "_PanelLayout";
    ViewData["Title"] = "İşlem Kayıtları";

    var visibleCount = Model.Items.Count();
}

<style>
    .al-page {
        color: #0b1c30;
        font-family: 'Hanken Grotesk', Arial, sans-serif;
    }

        .al-page *, .al-page *::before, .al-page *::after {
            box-sizing: border-box;
        }

    .al-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 20px;
        margin: 5px 0 26px;
    }

    .al-eyebrow {
        margin: 0 0 9px;
        font-size: 11px;
        font-weight: 800;
        color: #e78300;
        letter-spacing: 1.45px;
    }

    .al-heading h1 {
        margin: 0 0 8px;
        font-size: clamp(27px, 3vw, 34px);
        font-weight: 800;
        letter-spacing: -1px;
    }

    .al-subtitle {
        margin: 0;
        color: #8191a5;
        font-size: 13px;
        line-height: 1.6;
    }

    .al-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        min-height: 42px;
        padding: 10px 15px;
        border: 1px solid #dce6f2;
        border-radius: 10px;
        background: white;
        color: #224361;
        text-decoration: none;
        font-size: 12px;
        font-weight: 800;
        transition: background .15s;
    }

        .al-btn:hover {
            background: #eff5ff;
            color: #17334e;
        }

        .al-btn .material-symbols-outlined {
            font-size: 18px;
        }

    .al-kpis {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 17px;
        margin: 0 0 22px;
    }

    .al-kpi {
        background: #fff;
        border: 1px solid #e4eaf2;
        border-radius: 16px;
        padding: 22px 23px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        min-width: 0;
        box-shadow: 0 4px 17px rgba(10,31,54,.025);
    }

        .al-kpi.featured {
            background: linear-gradient(145deg,#0b1c30,#1b3858);
            border-color: #0b1c30;
            color: white;
        }

    .al-kpi-label {
        font-size: 12px;
        font-weight: 700;
        color: #7f90a6;
        margin-bottom: 13px;
    }

    .al-kpi.featured .al-kpi-label {
        color: #c5d2e4;
    }

    .al-kpi-value {
        font-size: 30px;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -.8px;
    }

    .al-kpi-foot {
        margin-top: 10px;
        color: #8da0b5;
        font-size: 11px;
    }

    .al-kpi.featured .al-kpi-foot {
        color: #bcd0e8;
    }

    .al-kpi-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        background: #f0f5fc;
        color: #355f8b;
    }

    .al-kpi.featured .al-kpi-icon {
        background: rgba(253,139,0,.18);
        color: #fd8b00;
    }

    .al-kpi-icon .material-symbols-outlined {
        font-size: 21px;
    }

    .al-card {
        background: white;
        border: 1px solid #e3eaf3;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(11,28,48,.035);
    }

    .al-card-head {
        padding: 23px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .al-card-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .al-card-icon {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        display: grid;
        place-items: center;
        background: #fff0df;
        color: #e78300;
        flex-shrink: 0;
    }

        .al-card-icon .material-symbols-outlined {
            font-size: 21px;
        }

    .al-card h2 {
        margin: 0 0 4px;
        font-size: 17px;
        font-weight: 800;
    }

    .al-card-head p {
        margin: 0;
        font-size: 12px;
        color: #8797aa;
    }

    .al-counter {
        display: inline-flex;
        gap: 7px;
        align-items: center;
        background: #edf3fb;
        border-radius: 9px;
        padding: 9px 12px;
        color: #254d78;
        font-size: 11px;
        font-weight: 800;
    }

    .al-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .al-table {
        width: 100%;
        min-width: 1060px;
        border-collapse: collapse;
    }

        .al-table th {
            text-align: left;
            padding: 16px 18px;
            background: #f7f9fd;
            color: #8295ad;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .5px;
            text-transform: uppercase;
            border-block: 1px solid #e9eef5;
        }

        .al-table td {
            color: #31455f;
            font-size: 12px;
            padding: 18px;
            border-bottom: 1px solid #edf1f6;
            vertical-align: top;
        }

        .al-table tbody tr:hover {
            background: #fcfdff;
        }

        .al-table tbody tr:last-child td {
            border-bottom: 0;
        }

    .al-date {
        font-size: 12px;
        font-weight: 800;
        color: #1a3453;
        white-space: nowrap;
    }

    .al-actor {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        min-width: 150px;
    }

    .al-avatar {
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        background: #eaf2fc;
        color: #315d85;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 800;
    }

    .al-actor-name {
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .al-operation {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        max-width: 190px;
        border-radius: 20px;
        padding: 7px 10px;
        font-size: 11px;
        font-weight: 800;
        background: #edf3fc;
        color: #355e83;
        overflow-wrap: anywhere;
    }

        .al-operation::before {
            content: '';
            display: inline-block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            flex-shrink: 0;
            background: currentColor;
        }

        .al-operation.create {
            background: #e7f8ee;
            color: #16825d;
        }

        .al-operation.update {
            background: #fff3e4;
            color: #c77910;
        }

        .al-operation.delete {
            background: #fff0f0;
            color: #c64242;
        }

    .al-entity {
        font-size: 12px;
        font-weight: 800;
        color: #253f5b;
    }

    .al-id {
        display: block;
        color: #8b99ad;
        margin-top: 6px;
        font-size: 10px;
        max-width: 170px;
        word-break: break-all;
        font-family: Consolas, monospace;
    }

    .al-desc {
        min-width: 180px;
        max-width: 310px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .al-details {
        position: relative;
    }

        .al-details > summary {
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            list-style: none;
            border: 1px solid #dce6f3;
            border-radius: 9px;
            padding: 9px 12px;
            background: #fff;
            color: #244b75;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

            .al-details > summary::-webkit-details-marker {
                display: none;
            }

        .al-details[open] > summary {
            background: #fff1df;
            border-color: #ffdfb5;
            color: #aa650d;
            margin-bottom: 13px;
        }

    .al-change {
        display: grid;
        gap: 10px;
        width: min(500px, 62vw);
    }

    .al-change-title {
        font-size: 11px;
        font-weight: 800;
        color: #54708a;
        margin: 0 0 6px;
    }

    .al-change-pre {
        background: #f6f9fd;
        border: 1px solid #e3ebf5;
        color: #304963;
        border-radius: 9px;
        padding: 11px;
        font-size: 11px;
        line-height: 1.5;
        margin: 0;
        max-height: 200px;
        overflow: auto;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .al-empty {
        padding: 60px 20px;
        text-align: center;
        color: #8292a5;
    }

    .al-empty-icon {
        height: 60px;
        width: 60px;
        display: grid;
        place-items: center;
        margin: 0 auto 14px;
        background: #f0f5fc;
        border-radius: 18px;
        color: #7194b9;
    }

        .al-empty-icon .material-symbols-outlined {
            font-size: 30px;
        }

    .al-empty strong {
        display: block;
        color: #1c3553;
        font-size: 16px;
        margin-bottom: 6px;
    }

    .al-empty p {
        font-size: 13px;
        margin: 0;
    }

    .al-card-foot {
        padding: 17px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        border-top: 1px solid #e9eef5;
    }

    .al-foot-note {
        margin: 0;
        color: #8595a9;
        font-size: 12px;
    }

    .al-pager {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
    }

    .al-page-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 35px;
        padding: 8px 12px;
        border: 1px solid #dde6f1;
        border-radius: 9px;
        color: #21496e;
        background: #fff;
        text-decoration: none;
        font-size: 11px;
        font-weight: 800;
    }

        .al-page-button:hover {
            background: #eff5fc;
            color: #173a5c;
        }

        .al-page-button .material-symbols-outlined {
            font-size: 16px;
        }

    .al-page-current {
        min-height: 35px;
        padding: 8px 13px;
        border-radius: 9px;
        background: #0b1c30;
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .al-note {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin: 17px 0 0;
        padding: 14px 17px;
        background: #eef4fb;
        border: 1px solid #e2eaf4;
        border-radius: 12px;
        color: #647c97;
        font-size: 12px;
        line-height: 1.55;
    }

        .al-note .material-symbols-outlined {
            color: #52779c;
            font-size: 18px;
        }

    @@media (max-width: 1050px) {
        .al-kpis {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

    @@media (max-width: 640px) {
        .al-heading {
            margin-bottom: 18px;
        }

        .al-kpis {
            grid-template-columns: 1fr;
            gap: 11px;
        }

        .al-card-head, .al-card-foot {
            padding: 17px;
        }

        .al-change {
            width: 380px;
            max-width: 75vw;
        }
    }
</style>

<section class="al-page">
    <!-- SAYFA BAŞLIĞI -->
    <div class="al-heading">
        <div>
            <p class="al-eyebrow">CARGOTRACK / SİSTEM YÖNETİMİ</p>
            <h1>İşlem Kayıtları</h1>
            <p class="al-subtitle">Sistemde kaydedilen işlemleri, kullanıcıları ve veri değişikliklerini inceleyin.</p>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="al-btn">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
            Genel Bakışa Dön
        </a>
    </div>

    <!-- GERÇEK VERİLERE DAYALI ÖZET KARTLARI -->
    <div class="al-kpis">
        <div class="al-kpi featured">
            <div>
                <div class="al-kpi-label">Toplam İşlem Kaydı</div>
                <div class="al-kpi-value">@Model.TotalCount</div>
                <div class="al-kpi-foot">Sistemde kayıtlı işlem sayısı</div>
            </div>
            <span class="al-kpi-icon"><span class="material-symbols-outlined" aria-hidden="true">history</span></span>
        </div>
        <div class="al-kpi">
            <div>
                <div class="al-kpi-label">Bu Sayfada</div>
                <div class="al-kpi-value">@visibleCount</div>
                <div class="al-kpi-foot">Şu anda listelenen kayıt</div>
            </div>
            <span class="al-kpi-icon"><span class="material-symbols-outlined" aria-hidden="true">table_rows</span></span>
        </div>
        <div class="al-kpi">
            <div>
                <div class="al-kpi-label">Sayfalama</div>
                <div class="al-kpi-value">@Model.Page / @Model.TotalPages</div>
                <div class="al-kpi-foot">Bulunduğunuz sayfa / toplam sayfa</div>
            </div>
            <span class="al-kpi-icon"><span class="material-symbols-outlined" aria-hidden="true">layers</span></span>
        </div>
    </div>

    <!-- İŞLEM KAYITLARI TABLOSU -->
    <div class="al-card">
        <div class="al-card-head">
            <div class="al-card-title">
                <span class="al-card-icon"><span class="material-symbols-outlined" aria-hidden="true">manage_history</span></span>
                <div>
                    <h2>Sistem İşlem Geçmişi</h2>
                    <p>Kullanıcı işlemleri ve değişiklik detayları</p>
                </div>
            </div>
            <span class="al-counter">@Model.TotalCount kayıt</span>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="al-empty">
                <span class="al-empty-icon"><span class="material-symbols-outlined" aria-hidden="true">event_note</span></span>
                <strong>Henüz işlem kaydı bulunmuyor</strong>
                <p>İşlemler kaydedildiğinde burada görüntülenecek.</p>
            </div>
        }
        else
        {
            <div class="al-table-wrap">
                <table class="al-table">
                    <thead>
                        <tr>
                            <th>TARİH</th>
                            <th>İŞLEMİ YAPAN</th>
                            <th>İŞLEM TÜRÜ</th>
                            <th>VARLIK / KAYIT</th>
                            <th>AÇIKLAMA</th>
                            <th>DEĞİŞİKLİK</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Items)
                        {
                            var operation = Convert.ToString(log.ActionType) ?? "İşlem";
                            var operationKey = operation.ToLowerInvariant();
                            var operationClass = operationKey.Contains("creat") || operationKey.Contains("add") || operationKey.Contains("insert") || operationKey.Contains("oluştur")
                                ? "create"
                                : operationKey.Contains("updat") || operationKey.Contains("edit") || operationKey.Contains("chang") || operationKey.Contains("güncelle")
                                ? "update"
                                : operationKey.Contains("delet") || operationKey.Contains("remov") || operationKey.Contains("sil")
                                ? "delete" : "";
                            var actorName = log.PerformedBy ?? "Sistem";
                            var actorInitial = !string.IsNullOrWhiteSpace(actorName)
                                ? actorName.Substring(0, 1).ToUpperInvariant()
                                : "S";

                            <tr>
                                <td><span class="al-date">@(log.ActionDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</span></td>
                                <td>
                                    <div class="al-actor">
                                        <span class="al-avatar">@actorInitial</span>
                                        <span class="al-actor-name">@actorName</span>
                                    </div>
                                </td>
                                <td><span class="al-operation @operationClass">@operation</span></td>
                                <td>
                                    <span class="al-entity">@log.EntityName</span>
                                    <span class="al-id">@log.EntityId</span>
                                </td>
                                <td class="al-desc">@log.Description</td>
                                <td>
                                    <details class="al-details">
                                        <summary>
                                            <span class="material-symbols-outlined" style="font-size:16px" aria-hidden="true">difference</span>
                                            İncele
                                        </summary>
                                        <div class="al-change">
                                            <div>
                                                <div class="al-change-title">Önceki Değerler</div>
                                                <pre class="al-change-pre">@log.OldValues</pre>
                                            </div>
                                            <div>
                                                <div class="al-change-title">Yeni Değerler</div>
                                                <pre class="al-change-pre">@log.NewValues</pre>
                                            </div>
                                        </div>
                                    </details>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="al-card-foot">
            <p class="al-foot-note">Bu sayfada <strong>@visibleCount</strong> kayıt gösteriliyor · Toplam <strong>@Model.TotalCount</strong> kayıt</p>
            @if (Model.TotalPages > 1)
            {
                <nav class="al-pager" aria-label="İşlem kayıtları sayfaları">
                    @if (Model.Page > 1)
                    {
                        <a asp-controller="AdminAuditLogs" asp-action="Index" asp-route-page="@(Model.Page - 1)" class="al-page-button">
                            <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span> Önceki
                        </a>
                    }
                    <span class="al-page-current">@Model.Page / @Model.TotalPages</span>
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-controller="AdminAuditLogs" asp-action="Index" asp-route-page="@(Model.Page + 1)" class="al-page-button">
                            Sonraki <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                        </a>
                    }
                </nav>
            }
        </div>
    </div>

    <div class="al-note">
        <span class="material-symbols-outlined" aria-hidden="true">info</span>
        <div>Eski ve yeni değerleri görüntülemek için ilgili kayıttaki <strong>İncele</strong> düğmesini kullanın. Tablo, küçük ekranlarda yatay kaydırılabilir.</div>
    </div>
</section>

