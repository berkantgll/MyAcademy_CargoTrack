@using CargoTrack.Entity.Enums
@model List<CargoTrack.DTO.CargoDtos.CargoListDto>

@{
    Layout = null;

    var title = ViewData["PageTitle"]?.ToString()
        ?? "CargoTrack Panel";

    bool isAdmin = User.IsInRole("Admin");
    bool isManager = User.IsInRole("Manager");
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@title - CargoTrack</title>

    <style>
            body {
                font-family: Arial, sans-serif;
                background: #f3f5fa;
                margin: 0;
                color: #14253d;
            }

            header {
                background: #14253d;
                color: white;
                padding: 20px 5%;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            main {
                margin: 40px auto;
                max-width: 1100px;
                padding: 0 20px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                background: white;
            }

            th, td {
                padding: 14px;
                text-align: left;
                border-bottom: 1px solid #e2e6ed;
            }

            th {
                background: #eaf0f8;
            }

            button {
                background: #ff9100;
                border: none;
                padding: 10px 18px;
                cursor: pointer;
                border-radius: 6px;
            }

            .empty {
                background: white;
                padding: 30px;
                border-radius: 10px;
            }

            .create-link {
                display: inline-block;
                background: #ff9100;
                color: #14253d;
                padding: 12px 18px;
                border-radius: 6px;
                text-decoration: none;
                margin: 15px 0;
                font-weight: bold;
            }

            .status-link {
                display: inline-block;
                background: #14253d;
                color: white;
                padding: 9px 12px;
                border-radius: 6px;
                text-decoration: none;
                font-size: 13px;
                white-space: nowrap;
            }

            .edit-link {
                display: inline-block;
                background: #198754;
                color: white;
                padding: 9px 12px;
                border-radius: 6px;
                text-decoration: none;
                font-size: 13px;
                white-space: nowrap;
            }

            .delete-btn {
                background: #dc3545;
                color: white;
                padding: 9px 12px;
                border: none;
                border-radius: 6px;
                cursor: pointer;
                font-size: 13px;
            }

            .detail-link {
                display: inline-block;
                background: #eaf0f8;
                color: #14253d;
                padding: 9px 12px;
                border-radius: 6px;
                text-decoration: none;
                font-size: 13px;
            }

            .success {
                color: green;
                margin: 15px 0;
            }

            .error {
                color: red;
                margin: 15px 0;
            }

            .table-container {
                overflow-x: auto;
            }

            .action-buttons {
                display: flex;
                align-items: center;
                gap: 6px;
                flex-wrap: wrap;
            }

                .action-buttons form {
                    margin: 0;
                }
    </style>
</head>

<body>

    <header>
        <strong>CargoTrack</strong>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit">
                Çıkış Yap
            </button>

        </form>
    </header>

    <main>

        <h1>@title</h1>

        <p>
            Hoş geldiniz, @User.Identity?.Name
        </p>

     
        @if (User.IsInRole("Admin"))
        {
            @await Component.InvokeAsync("AdminDashboard")
        }

        @if (User.IsInRole("Manager"))
        {
            @await Component.InvokeAsync("ManagerDashboard")
        }

        @if (User.IsInRole("User"))
        {
            @await Component.InvokeAsync("UserDashboard")
        }


        @if (TempData["Success"] != null)
        {
            <p class="success">
                @TempData["Success"]
            </p>
        }

        @if (TempData["Error"] != null)
        {
            <p class="error">
                @TempData["Error"]
            </p>
        }

        @if (isAdmin)
        {
            <a asp-controller="AdminCargos"
               asp-action="Create"
               class="create-link">

                + Yeni Kargo Oluştur

            </a>

            <a asp-controller="AdminCargos"
               asp-action="Index"
               class="create-link">

                Kargo Yönetimi

            </a>

            <a asp-controller="AdminAuditLogs"
               asp-action="Index"
               class="create-link">
                İşlem Kayıtları
            </a>

            <a asp-controller="AdminReports"
               asp-action="Index"
               class="create-link">
                Operasyon Raporları
            </a>

        }

        @if (isManager)
        {
            <a asp-controller="ManagerCargos"
               asp-action="Index"
               class="create-link">

                Şube Kargo Yönetimi

            </a>
        }

        <h2>Kargo Listesi</h2>

        @if (Model == null || Model.Count == 0)
        {
            <div class="empty">
                Henüz görüntülenecek kargo bulunmuyor.
            </div>
        }
        else
        {
            <div class="table-container">

                <table>
                    <thead>
                        <tr>
                            <th>Takip Numarası</th>
                            <th>Durum</th>
                            <th>Çıkış Şubesi</th>
                            <th>Varış Şubesi</th>
                            <th>Tarih</th>

                            @if (isAdmin || isManager)
                            {
                                <th>İşlemler</th>
                            }
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var cargo in Model)
                        {
                            bool isCompleted =
                                cargo.Status == CargoStatus.Delivered ||
                                cargo.Status == CargoStatus.ReturnedToSender;

                            <tr>

                                <td>
                                    @if (isAdmin)
                                    {
                                        <a asp-controller="AdminCargos"
                                           asp-action="Details"
                                           asp-route-id="@cargo.Id">

                                            @cargo.TrackingNumber

                                        </a>
                                    }
                                    else if (User.IsInRole("User"))
                                    {
                                        <a asp-controller="UserCargos"
                                           asp-action="Details"
                                           asp-route-id="@cargo.Id">
                                            @cargo.TrackingNumber
                                        </a>
                                    }
                                    else
                                    {
                                        @cargo.TrackingNumber
                                    }
                                </td>

                                <td>
                                    @cargo.Status
                                </td>

                                <td>
                                    @cargo.OriginBranchName
                                </td>

                                <td>
                                    @cargo.DestinationBranchName
                                </td>

                                <td>
                                    @cargo.CreatedDate.ToString("dd.MM.yyyy")
                                </td>

                                @if (isAdmin)
                                {
                                    <td>
                                        <div class="action-buttons">

                                            <a asp-controller="AdminCargos"
                                               asp-action="Details"
                                               asp-route-id="@cargo.Id"
                                               class="detail-link">

                                                Detay

                                            </a>

                                            @if (!isCompleted)
                                            {
                                                <a asp-controller="AdminCargos"
                                                   asp-action="Status"
                                                   asp-route-id="@cargo.Id"
                                                   class="status-link">

                                                    Durumu Değiştir

                                                </a>
                                            }

                                            @if (cargo.Status == CargoStatus.Created)
                                            {
                                                <a asp-controller="AdminCargos"
                                                   asp-action="Edit"
                                                   asp-route-id="@cargo.Id"
                                                   class="edit-link">

                                                    Güncelle

                                                </a>

                                                <form asp-controller="AdminCargos"
                                                      asp-action="Delete"
                                                      method="post"
                                                      onsubmit="return confirm('Bu kargoyu silmek istediğinize emin misiniz?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@cargo.Id" />

                                                    <button type="submit"
                                                            class="delete-btn">

                                                        Sil

                                                    </button>

                                                </form>
                                            }

                                        </div>
                                    </td>
                                }
                                else if (isManager)
                                {
                                    <td>
                                        <div class="action-buttons">

                                            @if (!isCompleted)
                                            {
                                                <a asp-controller="ManagerCargos"
                                                   asp-action="Status"
                                                   asp-route-id="@cargo.Id"
                                                   class="status-link">

                                                    Durumu Değiştir

                                                </a>
                                            }
                                            else
                                            {
                                                <span>
                                                    İşlem tamamlandı
                                                </span>
                                            }

                                        </div>
                                    </td>
                                }

                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        }

    </main>

</body>
</html>
