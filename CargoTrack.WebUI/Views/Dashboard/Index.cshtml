@using CargoTrack.Entity.Enums
@model List<CargoTrack.DTO.CargoDtos.CargoListDto>

@{
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Genel Bakış";

    bool isAdmin = User.IsInRole("Admin");
    bool isManager = User.IsInRole("Manager");
    bool isUser = User.IsInRole("User");

    var roleName = isAdmin ? "Sistem Yöneticisi"
        : isManager ? "Şube Yöneticisi"
        : isUser ? "Müşteri" : "Kullanıcı";

    var accountName = User.Identity?.Name ?? "Kullanıcı";
}
<div class="shell-page-bar">
    <p class="shell-welcome">Hoş geldiniz, @accountName</p>
    <span class="shell-role-pill">
        <span class="material-symbols-outlined">verified_user</span>
        @roleName
    </span>
</div>

@if (TempData["Success"] != null)
{
    <div class="shell-alert success" role="status">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="shell-alert error" role="alert">@TempData["Error"]</div>
}

<!-- VAR OLAN VIEWCOMPONENT VERİ BAĞLANTILARI -->
@if (isAdmin)
{
    @await Component.InvokeAsync("AdminDashboard")
}
@if (isManager)
{
    @await Component.InvokeAsync("ManagerDashboard")
}
@if (isUser)
{
    @await Component.InvokeAsync("UserDashboard")
}

<!-- KARGO LİSTESİ -->
<div class="shell-section-head">
    <div>
        <h2>Kargo Listesi</h2>
        <p>Gönderilerin güncel durumunu ve işlem seçeneklerini görüntüleyin.</p>
    </div>
    @if (isAdmin)
    {
        <a asp-controller="AdminCargos" asp-action="Create" class="shell-button-primary">
            <span class="material-symbols-outlined">add</span>
            Yeni Kargo Oluştur
        </a>
    }
    else if (isManager)
    {
        <a asp-controller="ManagerCargos" asp-action="Index" class="shell-button-primary">
            <span class="material-symbols-outlined">local_shipping</span>
            Şube Kargoları
        </a>
    }
</div>

<div class="shell-table-card">
    @if (Model == null || Model.Count == 0)
    {
        <div class="shell-empty">
            <div><span class="material-symbols-outlined">inventory_2</span></div>
            Henüz görüntülenecek kargo bulunmuyor.
        </div>
    }
    else
    {
        <div class="shell-table-scroll">
            <table class="shell-shipment-table">
                <thead>
                    <tr>
                        <th>TAKİP NUMARASI</th>
                        <th>DURUM</th>
                        <th>ÇIKIŞ ŞUBESİ</th>
                        <th>VARIŞ ŞUBESİ</th>
                        <th>TARİH</th>
                        @if (isAdmin || isManager)
                        {
                            <th>İŞLEMLER</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cargo in Model)
                    {
                        bool isCompleted =
                            cargo.Status == CargoStatus.Delivered ||
                            cargo.Status == CargoStatus.ReturnedToSender;

                        string statusText = cargo.Status switch
                        {
                            CargoStatus.Created => "Oluşturuldu",
                            CargoStatus.AtOriginBranch => "Çıkış Şubesinde",
                            CargoStatus.AtTransferCenter => "Transfer Merkezinde",
                            CargoStatus.AtDestinationBranch => "Varış Şubesinde",
                            CargoStatus.OutForDelivery => "Dağıtımda",
                            CargoStatus.Delivered => "Teslim Edildi",
                            CargoStatus.DeliveryFailed => "Teslim Edilemedi",
                            CargoStatus.ReturnInProgress => "İade Sürecinde",
                            CargoStatus.ReturnedToSender => "İade Edildi",
                            _ => cargo.Status.ToString()
                        };

                        string statusClass = cargo.Status switch
                        {
                            CargoStatus.Delivered => "done",
                            CargoStatus.ReturnedToSender => "returned",
                            CargoStatus.DeliveryFailed => "failed",
                            _ => ""
                        };

                        <tr>
                            <td>
                                @if (isAdmin)
                                {
                                    <a asp-controller="AdminCargos"
                                       asp-action="Details"
                                       asp-route-id="@cargo.Id"
                                       class="shell-tracking-link">@cargo.TrackingNumber</a>
                                }
                                else if (isUser)
                                {
                                    <a asp-controller="UserCargos"
                                       asp-action="Details"
                                       asp-route-id="@cargo.Id"
                                       class="shell-tracking-link">@cargo.TrackingNumber</a>
                                }
                                else
                                {
                                    <strong>@cargo.TrackingNumber</strong>
                                }
                            </td>
                            <td>
                                <span class="shell-status @statusClass">@statusText</span>
                            </td>
                            <td>@cargo.OriginBranchName</td>
                            <td>@cargo.DestinationBranchName</td>
                            <td>@(cargo.CreatedDate.ToString("dd.MM.yyyy"))</td>

                            @if (isAdmin)
                            {
                                <td>
                                    <div class="shell-actions">
                                        <a asp-controller="AdminCargos"
                                           asp-action="Details"
                                           asp-route-id="@cargo.Id"
                                           class="shell-action">Detay</a>

                                        @if (!isCompleted)
                                        {
                                            <a asp-controller="AdminCargos"
                                               asp-action="Status"
                                               asp-route-id="@cargo.Id"
                                               class="shell-action">Durum</a>
                                        }

                                        @if (cargo.Status == CargoStatus.Created)
                                        {
                                            <a asp-controller="AdminCargos"
                                               asp-action="Edit"
                                               asp-route-id="@cargo.Id"
                                               class="shell-action edit">Güncelle</a>

                                            <form asp-controller="AdminCargos"
                                                  asp-action="Delete"
                                                  method="post"
                                                  onsubmit="return confirm('Bu kargoyu silmek istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@cargo.Id" />
                                                <button type="submit" class="shell-action delete">Sil</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            }
                            else if (isManager)
                            {
                                <td>
                                    <div class="shell-actions">
                                        @if (!isCompleted)
                                        {
                                            <a asp-controller="ManagerCargos"
                                               asp-action="Status"
                                               asp-route-id="@cargo.Id"
                                               class="shell-action">Durumu Değiştir</a>
                                        }
                                        else
                                        {
                                            <span style="color:#8090a4;font-size:12px">İşlem tamamlandı</span>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

