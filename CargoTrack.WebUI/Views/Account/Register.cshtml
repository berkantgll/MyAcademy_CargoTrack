@model CargoTrack.DTO.AuthDtos.RegisterDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>CargoTrack - Kayıt Ol</title>
</head>
<body>
    <h2>CargoTrack - Kayıt Ol</h2>

    <form asp-controller="Account"
          asp-action="Register"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             style="color:red"></div>

        <div>
            <label>Ad</label>
            <input asp-for="FirstName" />
        </div>

        <div>
            <label>Soyad</label>
            <input asp-for="LastName" />
        </div>

        <div>
            <label>Telefon</label>
            <input asp-for="PhoneNumber" />
        </div>

        <div>
            <label>E-posta</label>
            <input asp-for="Email" />
        </div>

        <div>
            <label>Şifre</label>
            <input asp-for="Password" type="password" />
        </div>

        <div>
            <label>Şifre Tekrar</label>
            <input asp-for="ConfirmPassword"
                   type="password" />
        </div>

        <button type="submit">Kayıt Ol</button>
    </form>

    <a asp-controller="Account" asp-action="Login">
        Giriş Yap
    </a>
</body>
</html>
